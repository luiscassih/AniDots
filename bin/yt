#!/usr/bin/env bash
# yt — fzf front-end for yt-dlp
#
# Install : chmod +x yt && mv yt ~/.local/bin/      (any directory in your PATH)
# Needs   : bash >= 4, yt-dlp, fzf, jq
#           optional: `column` (aligned tables), `ffmpeg` (post-download conversion)
# Usage   : yt <url>
#
# Flow    : fetch formats -> pick video (fzf, or "none" = audio only)
#           -> pick audio (fzf, or "none" = video only)
#           -> pick subtitles (fzf, multi-select with Tab; skipped for audio-only;
#              English, Spanish and Japanese are listed first)
#           -> embed them / keep them as separate file(s) / both
#              (embed-only deletes the extra subtitle files afterwards)
#           -> conversion (only if ffmpeg is installed):
#                audio only    -> "convert to MP3?"
#                video / both  -> "convert to WhatsApp/shareable MP4?"
#              each with: No / Yes, replace the file / Yes, save as a copy
#           -> summary / confirm menu
#           -> yt-dlp -f ... [subtitle flags] [-o OUTPUT] URL  ->  ffmpeg (if asked)

# Subtitle languages listed first in the picker (base language code; "en" also
# covers en-US, en-GB, en-orig ...). Order here = order in the list.
PRIORITY_SUB_LANGS=(en es ja)

# Seconds yt-dlp waits before each subtitle download. YouTube rate-limits subtitle
# requests (HTTP 429), especially auto-translated ones; a pause makes that rarer.
SUB_SLEEP=5

# ffmpeg options used by the conversion stage (edit to taste).
# They go AFTER "-i INPUT" and BEFORE the output file.
FFMPEG_MP3_ARGS=(-vn -codec:a libmp3lame -q:a 2)                 # VBR ~190 kbps
FFMPEG_SHARE_ARGS=(-vcodec libx264 -pix_fmt yuv420p -acodec aac) # WhatsApp-friendly mp4

die() { echo "yt: $*" >&2; exit 1; }

JQ_DEFS='
def n: if . == null or . == "" then "-" else tostring end;
def real: . != null and . != "none";
def human:
  if . >= 1073741824 then ((. / 1073741824 * 100 | round) / 100 | tostring) + "GiB"
  elif . >= 1048576 then ((. / 1048576 * 10 | round) / 10 | tostring) + "MiB"
  else ((. / 1024 | round) | tostring) + "KiB" end;
def size:
  if .filesize then (.filesize | human)
  elif .filesize_approx then "~" + (.filesize_approx | human)
  else "-" end;
def rate: if . == null then "-" else ((. | round | tostring) + "k") end;
'

# ── helpers ──────────────────────────────────────────────────────────────

# Join all args, then drop every quote character and all whitespace.
# Handles: url   'url'   "url"   '"url"'   "'url'"   “url”   ...
clean_url() {
  local u="$*" q
  u=${u//[[:space:]]/}
  for q in '"' "'" '“' '”' '‘' '’'; do u=${u//"$q"/}; done
  printf '%s' "$u"
}

# Align tab-separated columns (falls back to raw TSV if `column` is missing).
align() {
  if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else cat; fi
}

# stdin: yt-dlp -J output  ->  aligned video table (first line = header)
video_rows() {
  {
    printf 'ID\tEXT\tRESOLUTION\tFPS\tSIZE\tTBR\tVCODEC\tNOTE\n'
    printf 'bv*\t(auto)\t-\t-\t-\t-\t-\tbest available video\n'
    printf 'none\t-\t-\t-\t-\t-\t-\tno video (audio only)\n'
    jq -r "$JQ_DEFS"'
      (.formats // [])
      | map(select(.vcodec | real))
      | sort_by(-(.height // 0), -(.fps // 0), -(.tbr // 0))
      | .[]
      | [ .format_id, .ext, (.resolution | n), (.fps | n), size, (.tbr | rate),
          (.vcodec | n),
          (((.format_note // "") + (if (.acodec | real) then " (has audio)" else "" end)) | ltrimstr(" ") | n) ]
      | @tsv'
  } | align
}

# stdin: yt-dlp -J output  ->  aligned audio table (first line = header)
audio_rows() {
  {
    printf 'ID\tEXT\tABR\tASR\tSIZE\tACODEC\tLANG\tNOTE\n'
    printf 'ba\t(auto)\t-\t-\t-\t-\t-\tbest available audio\n'
    printf 'none\t-\t-\t-\t-\t-\t-\tno separate audio (use video stream only)\n'
    jq -r "$JQ_DEFS"'
      (.formats // [])
      | map(select((.acodec | real) and ((.vcodec | real) | not)))
      | sort_by(-(.abr // .tbr // 0), (.language // ""))
      | .[]
      | [ .format_id, .ext, ((.abr // .tbr) | rate), (.asr | n), size,
          (.acodec | n), (.language | n), (.format_note | n) ]
      | @tsv'
  } | align
}

# stdin: yt-dlp -J output  ->  aligned subtitle table (first line = header).
# TYPE: manual | auto (YouTube's own speech recognition) | auto-translated (machine
# translation of the auto track, generated on request: listed, but the flakiest).
# Order: priority languages first (PRIORITY_SUB_LANGS; manual, auto, auto-translated
# for each), then every other language the same way, alphabetical.
sub_rows() {
  local prio
  prio=$(printf '%s\n' "${PRIORITY_SUB_LANGS[@]}" | jq -R . | jq -sc .)
  {
    printf 'LANG\tTYPE\tNAME\tFORMATS\n'
    printf 'none\t-\tNo subtitle (default)\t-\n'
    jq -r --argjson prio "$prio" "$JQ_DEFS"'
      def entries(kind; obj):
        (obj // {}) | to_entries
        | map(select(.key != "live_chat"))
        | map({ key,
                kind: (if kind == "auto" and any(.value[]; (.url // "") | test("[?&]tlang="))
                       then "auto-translated" else kind end),
                name: (.value[0].name | n),
                exts: ([.value[].ext] | unique | join(",") | n) });
      def rank:
        (.key | split("-")[0] | ascii_downcase) as $l
        | ($prio | index($l)) // ($prio | length);
      (entries("manual"; .subtitles) + entries("auto"; .automatic_captions))
      | sort_by([rank, (if .kind == "manual" then 0 elif .kind == "auto" then 1 else 2 end), .key])
      | .[]
      | [ .key, .kind, .name, .exts ]
      | @tsv'
  } | align
}

# pick <Video|Audio> <table>  ->  prints the selected row (empty if Esc)
pick() {
  printf '%s\n' "$2" | fzf --layout=reverse --height=80% --border --cycle --no-multi \
    --header-lines=1 \
    --prompt="$1 > " \
    --header="Select $1 format  ·  type to fuzzy-filter (id, ext, codec, lang...)  ·  Enter = select  ·  Esc = cancel"
}

# pick_subs <table>  ->  prints the selected rows, one per line (empty if Esc).
# Tab marks several rows; Enter confirms. Enter on the first row = no subtitles.
pick_subs() {
  printf '%s\n' "$1" | fzf --multi --layout=reverse --height=80% --border --cycle \
    --header-lines=1 \
    --prompt="Subtitles > " \
    --header="Select subtitles (en/es/ja first)  ·  Tab = mark several  ·  Enter = confirm ('none' = no subtitles)  ·  Esc = cancel"$'\n'"auto-translated = machine translation made on request; YouTube may rate-limit it (HTTP 429)"
}

# drop_none  (stdin -> stdout): removes the "none" row from a format table.
drop_none() { grep -v '^none[[:space:]]'; }

# pick_video <vtable> <current aid>   (can't pick "none" video if audio is "none")
pick_video() {
  local t=$1
  [[ $2 == none ]] && t=$(drop_none <<<"$t")
  pick Video "$t"
}

# pick_audio <atable> <current vid>   (can't pick "none" audio if video is "none")
pick_audio() {
  local t=$1
  [[ $2 == none ]] && t=$(drop_none <<<"$t")
  pick Audio "$t"
}

# set_video / set_audio <fzf row>  ->  sets vid|aid and vlabel|alabel (main's locals)
set_video() {
  vid=${1%%[[:space:]]*};  vlabel=$(printf '%s' "$1" | tr -s ' \t' ' ')
  [[ $vid == none ]] && vlabel="none (audio only)"
  return 0
}
set_audio() {
  aid=${1%%[[:space:]]*};  alabel=$(printf '%s' "$1" | tr -s ' \t' ' ')
  [[ $aid == none ]] && alabel="none (video only)"
  return 0
}

# ask_sub_mode  ->  sets sub_mode (embed|separate|both); returns 1 on Esc (sub_mode untouched)
ask_sub_mode() {
  local c
  c=$(printf '%s\n' \
        "Embed in the video (no extra subtitle file)" \
        "Separate subtitle file(s) only (.srt/.vtt/...)" \
        "Both: embed AND keep the separate file(s)" \
    | fzf --layout=reverse --height=40% --border --cycle --no-multi \
        --prompt='Subtitles > ' \
        --header="How do you want the subtitles?  ·  Enter = select  ·  Esc = cancel")
  case $c in
    Embed*)    sub_mode=embed ;;
    Separate*) sub_mode=separate ;;
    Both*)     sub_mode=both ;;
    *) return 1 ;;
  esac
}

# ── conversion stage ─────────────────────────────────────────────────────

# set_conv_kind -> sets conv_kind: "" (no ffmpeg) | mp3 (audio only) | share (has video)
set_conv_kind() {
  conv_kind=""
  (( have_ffmpeg )) || return 0
  if [[ $vid == none ]]; then conv_kind=mp3; else conv_kind=share; fi
}

# ask_convert <mp3|share>  ->  sets conv (no|replace|copy); returns 1 on Esc (conv untouched)
ask_convert() {
  local kind=$1 hdr what c
  if [[ $kind == mp3 ]]; then
    hdr="Convert the downloaded audio to MP3?"; what="MP3"
  else
    hdr="Convert to a WhatsApp/shareable video (H.264 + AAC .mp4)?"; what="MP4"
  fi
  c=$(printf '%s\n' "No" "Yes, and replace the file with the $what" "Yes, but save it as a copy (keep both)" \
    | fzf --layout=reverse --height=40% --border --cycle --no-multi \
        --prompt='Convert > ' --header="$hdr  ·  Enter = select  ·  Esc = cancel")
  case $c in
    "No")               conv=no ;;
    "Yes, and replace"*) conv=replace ;;
    "Yes, but save"*)    conv=copy ;;
    *) return 1 ;;
  esac
}

# unique_path <base> <ext>  ->  base.ext, or "base (converted).ext", "base (converted 2).ext" ...
unique_path() {
  local base=$1 ext=$2 p="$1.$2" n=1
  while [[ -e $p ]]; do
    if (( n == 1 )); then p="$base (converted).$ext"; else p="$base (converted $n).$ext"; fi
    n=$((n + 1))
  done
  printf '%s' "$p"
}

# convert_file <mp3|share> <replace|copy> <input file>
# Converts into a temp file first; the original is only removed once ffmpeg succeeded.
convert_file() {
  local kind=$1 mode=$2 in=$3
  local base=${in%.*} inext=${in##*.} ext dest tmp
  local -a ff

  if [[ $kind == mp3 ]]; then ext=mp3; ff=("${FFMPEG_MP3_ARGS[@]}")
  else                        ext=mp4; ff=("${FFMPEG_SHARE_ARGS[@]}"); fi

  if [[ $kind == mp3 && ${inext,,} == mp3 ]]; then
    echo "→ Already an MP3, nothing to convert." >&2
    return 0
  fi

  dest="$base.$ext"
  if [[ $mode == copy ]]; then
    dest=$(unique_path "$base" "$ext")                       # never clobber the original
  elif [[ -e $dest && $dest != "$in" ]]; then
    dest=$(unique_path "$base" "$ext")                       # replace, but another file is in the way
  fi
  tmp="$base.converting.$ext"

  echo "→ Converting to $ext …" >&2
  if ! ffmpeg -nostdin -hide_banner -loglevel warning -stats -y -i "$in" "${ff[@]}" "$tmp"; then
    rm -f -- "$tmp"
    echo "yt: ffmpeg failed — the original file was kept." >&2
    return 1
  fi

  mv -f -- "$tmp" "$dest"
  if [[ $mode == replace ]]; then
    [[ $dest == "$in" ]] || rm -f -- "$in"
    echo "✓ Saved (original replaced): $dest" >&2
  else
    echo "✓ Saved copy: $dest   (original kept: $in)" >&2
  fi
}

# parse_subs <fzf output>  ->  sets sub_langs, sub_labels, has_auto (globals)
parse_subs() {
  local line id type
  sub_langs=(); sub_labels=(); has_auto=0
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    read -r id type _ <<<"$line"
    [[ $id == none ]] && continue
    sub_labels+=("$id ($type)")
    if [[ $type == auto* ]]; then has_auto=1; fi
    [[ " ${sub_langs[*]} " == *" $id "* ]] || sub_langs+=("$id")
  done <<<"$1"
}

# build_output <raw input>  ->  sets the global array out_args
#   ""                 -> ()                                   (unset override)
#   hello              -> -o 'hello.%(ext)s'
#   hello.mp4          -> -o 'hello.%(ext)s' --merge-output-format mp4
#   ~/Downloads/clip   -> -o '/home/you/Downloads/clip.%(ext)s'
#   ~/Downloads/       -> -o '/home/you/Downloads/%(title)s [%(id)s].%(ext)s'
build_output() {
  local n="$1" ext="" tpl low q i
  out_args=()

  n="${n#"${n%%[![:space:]]*}"}"                  # trim whitespace
  n="${n%"${n##*[![:space:]]}"}"
  for i in 1 2; do                                # trim surrounding quotes (also nested '"x"')
    for q in '"' "'" '“' '”' '‘' '’'; do n=${n#"$q"}; n=${n%"$q"}; done
  done
  n=$(printf '%s' "$n" | sed -E 's/\\(.)/\1/g')   # un-escape "My\ Folder" from Tab completion
  [[ -z $n ]] && return 0

  if [[ $n == "~" || $n == "~/"* ]]; then n="$HOME${n#\~}"; fi

  if [[ $n == */ || -d $n ]]; then
    tpl="${n%/}/%(title)s [%(id)s].%(ext)s"
  else
    low=${n,,}
    case $low in
      *.mp4|*.mkv|*.webm|*.mov|*.avi|*.flv) ext=${low##*.}; n=${n%.*} ;;
    esac
    if [[ $n == *'%(ext)s'* ]]; then tpl=$n; else tpl="$n.%(ext)s"; fi
  fi

  out_args=(-o "$tpl")
  [[ -n $ext ]] && out_args+=(--merge-output-format "$ext")
  return 0
}

# ── main ─────────────────────────────────────────────────────────────────

main() {
  (( BASH_VERSINFO[0] >= 4 )) || die "bash >= 4 is required (on macOS: brew install bash)."

  local dep
  for dep in yt-dlp fzf jq; do
    command -v "$dep" >/dev/null 2>&1 || die "'$dep' is required but not installed."
  done
  local have_ffmpeg=0
  command -v ffmpeg >/dev/null 2>&1 && have_ffmpeg=1

  local url
  url=$(clean_url "$@")
  [[ -n $url ]] || { echo "usage: yt <url>" >&2; exit 1; }

  local json vtable atable vrow arow vid aid vlabel alabel
  local out_raw="" out_item out_disp fmt summary choice row tmp
  local stable sub_sel sub_disp sub_available=0 has_auto=0 langs l sub_mode=embed
  local conv=no conv_kind="" conv_prev_kind="" conv_disp conv_what conv_menu
  local pathfile outfile status sub_note
  local -a out_args cmd sub_args sub_langs sub_labels menu

  echo "→ Fetching formats for $url …" >&2
  json=$(yt-dlp -J --no-playlist --no-warnings "$url") || die "yt-dlp could not fetch the format list."
  [[ -n $json ]] || die "empty response from yt-dlp."

  vtable=$(video_rows <<<"$json") || exit 1
  atable=$(audio_rows <<<"$json") || exit 1

  # 1) initial video + audio selection (Esc here cancels everything)
  #    "none" on one side forces a real choice on the other.
  vrow=$(pick_video "$vtable" "")
  [[ -n $vrow ]] || { echo "yt: cancelled." >&2; exit 130; }
  set_video "$vrow"

  arow=$(pick_audio "$atable" "$vid")
  [[ -n $arow ]] || { echo "yt: cancelled." >&2; exit 130; }
  set_audio "$arow"

  # subtitles (multi-select; Enter on "none" or no subtitles available = none).
  # Not asked for audio-only downloads (nothing to embed them into).
  parse_subs ""
  stable=$(sub_rows <<<"$json") || exit 1
  if (( $(printf '%s\n' "$stable" | wc -l) > 2 )); then
    sub_available=1
    if [[ $vid != none ]]; then
      sub_sel=$(pick_subs "$stable")
      [[ -n $sub_sel ]] || { echo "yt: cancelled." >&2; exit 130; }
      parse_subs "$sub_sel"
      if (( ${#sub_langs[@]} )); then
        ask_sub_mode || { echo "yt: cancelled." >&2; exit 130; }
      fi
    fi
  else
    echo "→ No subtitles available for this video." >&2
  fi

  # conversion (needs ffmpeg): mp3 for audio-only, WhatsApp-friendly mp4 otherwise
  set_conv_kind
  if [[ -n $conv_kind ]]; then
    ask_convert "$conv_kind" || { echo "yt: cancelled." >&2; exit 130; }
  fi
  conv_prev_kind=$conv_kind

  # 2) summary / confirm loop
  while true; do
    build_output "$out_raw"

    # Video <-> audio-only switches change which conversion applies: reset to "no".
    set_conv_kind
    if [[ $conv_kind != "$conv_prev_kind" ]]; then conv=no; conv_prev_kind=$conv_kind; fi

    # embed    : --write-subs ... --embed-subs --compat-options no-keep-subs
    #            (the extra subtitle files are deleted once embedded)
    # separate : --write-subs ...                (files only, nothing embedded)
    # both     : --write-subs ... --embed-subs   (embedded + files kept)
    # Manual subtitles win over auto ones for the same language.
    sub_args=(); sub_disp="none"
    if [[ $vid == none ]]; then
      sub_disp="n/a (audio only)"
    elif (( ${#sub_langs[@]} )); then
      langs=$(IFS=,; printf '%s' "${sub_langs[*]}")
      sub_args=(--write-subs)
      (( has_auto )) && sub_args+=(--write-auto-subs)
      # --ignore-errors: a failed subtitle (e.g. HTTP 429) only warns and the video is
      # still downloaded; by default yt-dlp aborts the whole download. Real download or
      # post-processing errors still give a non-zero exit status.
      sub_args+=(--sub-langs "$langs" --sleep-subtitles "$SUB_SLEEP" --ignore-errors)
      case $sub_mode in
        embed)    sub_args+=(--embed-subs --compat-options no-keep-subs)
                  sub_note="embedded, no extra file" ;;
        separate) sub_note="separate file(s) only" ;;
        both)     sub_args+=(--embed-subs)
                  sub_note="embedded + separate file(s)" ;;
      esac
      sub_disp=""
      for l in "${sub_labels[@]}"; do sub_disp+="${sub_disp:+, }$l"; done
      sub_disp+="  →  $sub_note"
    fi

    if [[ $vid == none ]]; then
      if [[ $aid == ba ]]; then fmt='ba/b'; else fmt=$aid; fi
    elif [[ $aid == none ]]; then
      fmt=$vid
    elif [[ $vid == 'bv*' && $aid == ba ]]; then
      fmt='bv*+ba/b'
    else
      fmt="$vid+$aid"
    fi

    if [[ -z $out_raw ]]; then
      out_disp='(not set → ./%(title)s [%(id)s].%(ext)s)'
    else
      out_disp="$out_raw   →   ${out_args[*]}"
    fi

    out_item="Overwrite output name"
    [[ -n $out_raw ]] && out_item="Change output name"

    # conversion line / menu entry (only when ffmpeg is available)
    conv_disp=""; conv_menu=""
    if [[ -n $conv_kind ]]; then
      if [[ $conv_kind == mp3 ]]; then conv_what="MP3"; conv_menu="Change MP3 conversion"
      else conv_what="WhatsApp-compatible MP4"; conv_menu="Change WhatsApp conversion"; fi
      case $conv in
        no)      conv_disp="no" ;;
        replace) conv_disp="$conv_what (replaces the downloaded file)" ;;
        copy)    conv_disp="$conv_what (kept as a copy next to the original)" ;;
      esac
      conv_disp=$'\n'"  Convert: $conv_disp"
    fi

    summary="  URL    : $url
  Video  : $vlabel
  Audio  : $alabel
  Subs   : $sub_disp
  Output : $out_disp
  Format : -f $fmt$conv_disp

  OK to download?"

    menu=("Yes" "Change Video" "Change Audio")
    (( sub_available )) && [[ $vid != none ]] && menu+=("Change Subtitles")
    (( ${#sub_langs[@]} )) && [[ $vid != none ]] && menu+=("Change Subtitle mode")
    [[ -n $conv_menu ]] && menu+=("$conv_menu")
    menu+=("$out_item" "Exit & Cancel")

    choice=$(printf '%s\n' "${menu[@]}" \
      | fzf --layout=reverse --height=60% --border --cycle --no-multi \
            --prompt='Download? > ' --header="$summary")

    case $choice in
      Yes)
        break
        ;;
      "Change Video")
        if row=$(pick_video "$vtable" "$aid") && [[ -n $row ]]; then
          set_video "$row"
        fi
        ;;
      "Change Audio")
        if row=$(pick_audio "$atable" "$vid") && [[ -n $row ]]; then
          set_audio "$row"
        fi
        ;;
      "Change Subtitles")
        if row=$(pick_subs "$stable") && [[ -n $row ]]; then
          parse_subs "$row"
          (( ${#sub_langs[@]} )) && { ask_sub_mode || true; }
        fi
        ;;
      "Change Subtitle mode")
        ask_sub_mode || true
        ;;
      "Change MP3 conversion"|"Change WhatsApp conversion")
        ask_convert "$conv_kind" || true
        ;;
      "Overwrite output name"|"Change output name")
        {
          echo
          printf '\e[38;5;244m'
          echo 'Output name: a plain name ("hello" -> hello.<ext>), a relative or absolute path'
          echo '(~/Downloads/hello, /data/clips/hello), or a folder ending in / (keeps the video title).'
          echo 'Press Tab to complete paths.  Leave it BLANK to unset the override.'
          printf '\e[0m'
        } >&2
        tmp=$out_raw
        if read -e -r -i "$out_raw" -p "Output › " tmp; then
          build_output "$tmp"
          if (( ${#out_args[@]} == 0 )); then
            out_raw=""
            echo "→ Output name unset." >&2
          else
            out_raw=$tmp
          fi
        fi
        ;;
      *)  # "Exit & Cancel" or Esc
        echo "yt: cancelled." >&2
        exit 130
        ;;
    esac
  done

  # 3) download. The final file path is written to a temp file (after any merge /
  #    subtitle embedding / move) so the conversion step knows what to feed ffmpeg.
  pathfile=$(mktemp) || die "could not create a temp file."
  trap 'rm -f "$pathfile"' EXIT

  cmd=(yt-dlp --no-playlist -f "$fmt" "${sub_args[@]}" "${out_args[@]}"
       --print-to-file 'after_move:filepath' "$pathfile" "$url")
  { printf '→ '; printf '%q ' "${cmd[@]}"; echo; } >&2
  "${cmd[@]}"; status=$?
  (( status == 0 )) || exit "$status"

  # 4) optional conversion
  if [[ -n $conv_kind && $conv != no ]]; then
    outfile=$(tail -n 1 "$pathfile")
    if [[ -z $outfile || ! -f $outfile ]]; then
      echo "yt: couldn't determine the downloaded file — skipping conversion." >&2
      exit 0
    fi
    convert_file "$conv_kind" "$conv" "$outfile" || exit 1
  fi
}

main "$@"
